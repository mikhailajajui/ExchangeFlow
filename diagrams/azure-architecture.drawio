ertex="1" parent="1"><mxGeometry x="895" y="60" width="130" height="1500" as="geometry"/></mxCell><mxCell id="flow-l8" value="worker&lt;br&gt;(outbox relay)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1070" y="60" width="130" height="1500" as="geometry"/></mxCell><mxCell id="flow-l9" value="Reviewer browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1245" y="60" width="130" height="1500" as="geometry"/></mxCell><mxCell id="flow-n10" value="&lt;b&gt;Sign-in (BFF)&lt;/b&gt; — no tokens in the browser" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="300" height="24" as="geometry"/></mxCell><mxCell id="flow-m11" value="1. GET / (no session)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="182" as="sourcePoint"/><mxPoint x="435.0" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m12" value="2. forward over private link" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="218" as="sourcePoint"/><mxPoint x="610.0" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m13" value="3. 302 to Entra (auth code + PKCE)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="254" as="sourcePoint"/><mxPoint x="85.0" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m14" value="4. sign in; MFA by Conditional Access" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="290" as="sourcePoint"/><mxPoint x="260.0" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m15" value="5. redirect with code" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="326" as="sourcePoint"/><mxPoint x="85.0" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m16" value="6. GET /callback?code (via Front Door)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="362" as="sourcePoint"/><mxPoint x="610.0" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m17" value="7. exchange code (confidential client, Key Vault cert)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="398" as="sourcePoint"/><mxPoint x="260.0" y="398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m18" value="8. tokens (identity only)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="434" as="sourcePoint"/><mxPoint x="610.0" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m19" value="9. create session; load roles + branch from app DB" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="470" as="sourcePoint"/><mxPoint x="960.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m20" value="10. Set-Cookie __Host- session (HttpOnly, SameSite)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="506" as="sourcePoint"/><mxPoint x="85.0" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n21" value="&lt;b&gt;Submit&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="528" width="120" height="24" as="geometry"/></mxCell><mxCell id="flow-m22" value="11. POST /requests (cookie, CSRF, Idempotency-Key)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="574" as="sourcePoint"/><mxPoint x="435.0" y="574" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m23" value="12. WAF; forward; X-Azure-FDID checked" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="610" as="sourcePoint"/><mxPoint x="610.0" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n24" value="authorize; validate body (strict schema);&lt;br&gt;build context server-side; asOf = clock" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="632" width="300" height="40" as="geometry"/></mxCell><mxCell id="flow-m25" value="13. look up (submitter, idempotency key)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="694" as="sourcePoint"/><mxPoint x="960.0" y="694" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m26" value="14. 200 stored response, or 422 IDEMPOTENCY_MISMATCH" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="748" as="sourcePoint"/><mxPoint x="85.0" y="748" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-f27" value="alt [key already used]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=200;height=24;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=none;strokeColor=#B85450;fontColor=#B85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="25.0" y="712" width="745.0" height="66" as="geometry"/></mxCell><mxCell id="flow-m28" value="15. read policy pointer + control row (never cached)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="794" as="sourcePoint"/><mxPoint x="960.0" y="794" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m29" value="16. evaluate(context, policy[cached by id], control, asOf)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="830" as="sourcePoint"/><mxPoint x="785.0" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m30" value="17. Decision (+ shadowResults, hashes, engineVersion)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="866" as="sourcePoint"/><mxPoint x="610.0" y="866" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m31" value="18. BEGIN; SELECT control_revision FOR SHARE" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="902" as="sourcePoint"/><mxPoint x="960.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m32" value="19. ROLLBACK; re-evaluate once, else HUMAN_REVIEW / ENGINE_PAUSED" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="956" as="sourcePoint"/><mxPoint x="960.0" y="956" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-f33" value="alt [control revision changed]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=200;height=24;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=none;strokeColor=#B85450;fontColor=#B85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="550.0" y="920" width="470.0" height="66" as="geometry"/></mxCell><mxCell id="flow-m34" value="20. INSERT request+revision, decision_record (full input), audit, outbox; counters; COMMIT" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1002" as="sourcePoint"/><mxPoint x="960.0" y="1002" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m35" value="21. 201 (id, status, version, outcome, generic reason) via Front Door" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1038" as="sourcePoint"/><mxPoint x="85.0" y="1038" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n36" value="&lt;b&gt;Notify&lt;/b&gt; — inbox polling, no WebSocket service" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="330" height="24" as="geometry"/></mxCell><mxCell id="flow-m37" value="22. relay outbox (FOR UPDATE SKIP LOCKED) → inbox rows; mark relayed" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="1106" as="sourcePoint"/><mxPoint x="960.0" y="1106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m38" value="23. GET /queue, /inbox every 15–30 s (via Front Door)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310.0" y="1142" as="sourcePoint"/><mxPoint x="610.0" y="1142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m39" value="24. queue + notifications (IDs and codes only)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1178" as="sourcePoint"/><mxPoint x="1310.0" y="1178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n40" value="&lt;b&gt;Decide&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1200" width="120" height="24" as="geometry"/></mxCell><mxCell id="flow-m41" value="25. POST /requests/{id}/decision (cookie, CSRF, expectedVersion, step-up if required)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310.0" y="1246" as="sourcePoint"/><mxPoint x="610.0" y="1246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n42" value="authorize; branch scope; reviewer ≠ submitter;&lt;br&gt;transition table; reason required" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1268" width="300" height="40" as="geometry"/></mxCell><mxCell id="flow-m43" value="26. UPDATE ... WHERE version = n; review_decision UNIQUE(cycle); audit; outbox; COMMIT" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1330" as="sourcePoint"/><mxPoint x="960.0" y="1330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-m44" value="27. 200, or 409 STALE_REQUEST with current state" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="1366" as="sourcePoint"/><mxPoint x="1310.0" y="1366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow-n45" value="&lt;b&gt;Invariants&lt;/b&gt;&lt;br&gt;• No automated outcome commits after a pause (locked revision check)&lt;br&gt;• One request per idempotency key · one final decision per cycle&lt;br&gt;• Every decision stores its full input for replay&lt;br&gt;• Notification failure never undoes a decision" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1422" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="priv" name="Privileged flows - rules, pause, anchoring"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="priv-t1" value="ExchangeFlow — Privileged flows: rule approval, two-person activation, pause, audit anchoring" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="40" as="geometry"/></mxCell><mxCell id="priv-l2" value="Policy author" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l3" value="Policy approver" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="180" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l4" value="Policy owner /&lt;br&gt;compliance / manager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l5" value="api" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l6" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l7" value="anchor job" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l8" value="Key Vault" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l9" value="Immutable Blob&lt;br&gt;(audit subscription)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1140" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-l10" value="SIEM / security&lt;br&gt;workspace" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="130" height="1250" as="geometry"/></mxCell><mxCell id="priv-n11" value="&lt;b&gt;Draft and approve&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="170" height="24" as="geometry"/></mxCell><mxCell id="priv-m12" value="1. POST rule version (draft; schema v1)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="182" as="sourcePoint"/><mxPoint x="565.0" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m13" value="2. insert immutable draft + content hash; audit" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="218" as="sourcePoint"/><mxPoint x="725.0" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m14" value="3. approve (step-up MFA; content hash)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245.0" y="254" as="sourcePoint"/><mxPoint x="565.0" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-n15" value="approver ≠ author; role conflicts checked;&lt;br&gt;regulated class derived by the system" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="415.0" y="276" width="300" height="40" as="geometry"/></mxCell><mxCell id="priv-m16" value="4. approval record bound to hash; audit" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="338" as="sourcePoint"/><mxPoint x="725.0" y="338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m17" value="5. alert: rule approved" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="374" as="sourcePoint"/><mxPoint x="1365.0" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-n18" value="&lt;b&gt;Shadow, then activate an AUTO_APPROVE rule&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="396" width="330" height="24" as="geometry"/></mxCell><mxCell id="priv-m19" value="6. publish policy version (rule in SHADOW)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245.0" y="442" as="sourcePoint"/><mxPoint x="565.0" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m20" value="7. new immutable manifest; move pointer; audit" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="478" as="sourcePoint"/><mxPoint x="725.0" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m21" value="8. request activation (agreement ≥ threshold, specificity passed)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245.0" y="514" as="sourcePoint"/><mxPoint x="565.0" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m22" value="9. co-sign activation (second person; step-up)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405.0" y="550" as="sourcePoint"/><mxPoint x="565.0" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m23" value="10. publish manifest with rule ACTIVE; two signatures; audit" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="586" as="sourcePoint"/><mxPoint x="725.0" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m24" value="11. alert: rule activated" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="622" as="sourcePoint"/><mxPoint x="1365.0" y="622" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-n25" value="&lt;b&gt;Pause (always safe)&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="644" width="170" height="24" as="geometry"/></mxCell><mxCell id="priv-m26" value="12. pause rule or engine (mandatory reason)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405.0" y="690" as="sourcePoint"/><mxPoint x="565.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m27" value="13. SELECT policy_control FOR UPDATE; revision + 1; control_event; COMMIT" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="726" as="sourcePoint"/><mxPoint x="725.0" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m28" value="14. alert: paused" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565.0" y="762" as="sourcePoint"/><mxPoint x="1365.0" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-n29" value="next evaluation: affected requests → HUMAN_REVIEW;&lt;br&gt;in-flight submits fail the revision check" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="415.0" y="784" width="320" height="40" as="geometry"/></mxCell><mxCell id="priv-n30" value="&lt;b&gt;Audit anchoring and verification&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="832" width="260" height="24" as="geometry"/></mxCell><mxCell id="priv-m31" value="15. read audit tail (last_seq, last_hash, count)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="878" as="sourcePoint"/><mxPoint x="725.0" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m32" value="16. sign(head) with non-exportable key" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="914" as="sourcePoint"/><mxPoint x="1045.0" y="914" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m33" value="17. signature + key version" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045.0" y="950" as="sourcePoint"/><mxPoint x="885.0" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m34" value="18. write anchor {last_seq, last_hash, count, key_version, signature}" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="986" as="sourcePoint"/><mxPoint x="1205.0" y="986" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m35" value="19. nightly: verify chain against latest anchor" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="1022" as="sourcePoint"/><mxPoint x="725.0" y="1022" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-m36" value="20. alert (Sev-1) on verification or anchor failure" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0078D4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="1058" as="sourcePoint"/><mxPoint x="1365.0" y="1058" as="targetPoint"/></mxGeometry></mxCell><mxCell id="priv-n37" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Author cannot approve; admin cannot hold policy roles&lt;br&gt;• Auto-approve activation needs two people other than the author&lt;br&gt;• Resume needs an approver (two people for auto-approve rules)&lt;br&gt;• Rolling back the app never changes rule data" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1114" width="480" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>